[Unit]
Description=Restart devices after resume
# The sleep operation runs before the final suspend/hibernate targets.
Before=sleep.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
ExecStart=/usr/lib/open-fprintd/suspend.py

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
